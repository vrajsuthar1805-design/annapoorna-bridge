PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/annapoorna_bridge
USE_IN_MEMORY_DB=auto
JWT_SECRET=annapoorna_bridge_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Notifications (Simulated mode enabled by default for zero-friction local testing)
SIMULATE_NOTIFICATIONS=true

# Optional SMTP Settings (if using real email alerts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Annapoorna Bridge Alerts <alerts@annapoornabridge.org>"

# Optional Twilio SMS Settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
