# Annapoorna Bridge Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Optional: If local MongoDB is not running, the platform seamlessly uses embedded high-speed storage)
MONGODB_URI=mongodb://localhost:27017/annapoorna_bridge

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Organization Details
PLATFORM_NAME=Annapoorna Bridge
SUPPORT_EMAIL=support@annapoornabridge.org

# Supabase Cloud Database (Optional: Add your project credentials from supabase.com)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-role-key
